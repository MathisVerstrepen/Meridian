        "@vue/test-utils": "^2.5.1",
        "happy-dom": "^21.0.4",
        "oxlint": "1.89.0",
        "typescript": "~6.0.3",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    }
