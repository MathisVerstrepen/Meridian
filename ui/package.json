{
    "name": "meridian-ui",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "test:e2e": "playwright test --grep-invert @performance",
        "test:e2e:full": "playwright test --grep-invert @performance",
        "test:e2e:smoke": "playwright test --grep @smoke --grep-invert @performance",
        "test:e2e:performance": "playwright test --grep @performance --workers=1",
        "test:e2e:bench": "node e2e/scripts/markdownRendererBench.mjs",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.1.1",
        "@headlessui/tailwindcss": "^0.2.2",
        "@nuxt/image": "^2.2.0",
        "@pinia/nuxt": "^1.0.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@vue-flow/additional-components": "^1.3.3",
        "@vue-flow/controls": "^1.1.3",
        "@vue-flow/core": "^1.48.2",
        "@vue-flow/node-resizer": "^1.5.1",
        "@vueuse/core": "^15.0.0",
        "babel-runtime": "^6.26.0",
        "katex": "^0.18.11",
        "marked": "^18.1.1",
        "marked-highlight": "^2.2.4",
        "marked-katex-extension": "^5.1.13",
        "mermaid": "^12.2.0",
        "motion-v": "^2.8.0",
        "nuxt": "^4.6.2",
        "nuxt-auth-utils": "^0.5.32",
        "nuxt-headlessui": "^1.2.2",
        "pinia": "^4.1.0",
        "pinia-plugin-persistedstate": "^4.7.1",
        "prettier": "^3.9.10",
        "prettier-plugin-classnames": "^0.10.4",
        "prettier-plugin-merge": "^0.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shiki": "^4.5.0",
        "tailwindcss": "^4.3.3",
        "uuid": "^14.0.3",
        "vue": "^3.5.44",
        "vue-color": "^3.3.3",
        "vue-cropperjs": "^5.0.0",
        "vue-router": "^5.4.0",
        "vue-virtual-scroller": "3.0.5"
